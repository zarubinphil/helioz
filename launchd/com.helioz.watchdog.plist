<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.helioz.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HELIOZ_HOME__/scripts/helioz-watchdog.sh</string>
  </array>
  <key>StartInterval</key><integer>120</integer>
  <key>StandardOutPath</key><string>__HELIOZ_HOME__/.helioz/state/logs/launchd-watchdog.log</string>
  <key>StandardErrorPath</key><string>__HELIOZ_HOME__/.helioz/state/logs/launchd-watchdog.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__USER_HOME__/.local/bin:__USER_HOME__/.npm-global/bin:__USER_HOME__/.kimi-code/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
